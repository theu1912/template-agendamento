# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# Connection string do Postgres (Neon/Supabase/Vercel Postgres). Formato:
# postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# URL de webhook do Make.com (opcional — dispara notificação a cada agendamento)
VITE_WEBHOOK_URL=

# Senha de acesso ao painel /admin (tela "Acesso Restrito"), validada no server
ADMIN_PASSWORD=

# Chave da API da Anthropic, usada pelo chatbot de agendamento (server/routers.ts)
ANTHROPIC_API_KEY=

# Senha da "Área do Gerente" dentro do painel (dados de faturamento/despesas)
VITE_SENHA_MESTRE=

# Token interno usado por rotas administrativas (ver server/_core)
ADMIN_TOKEN=
